# ========================================================================
# Dr. Gopi's Clinic - Next.js Environment Variables
# ========================================================================

# Company Webhosting MySQL Connection URL (Used by Prisma)
# Replace user, password, host, port (default 3306), and dbname
# Note: In cPanel, ensure "Remote MySQL" has '%' or Vercel access allowed.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@YOUR_COMPANY_HOST:3306/DB_NAME?connection_limit=5"

# Admin Secret Passcode for Doctor Dashboard
ADMIN_SECRET_TOKEN="DrGopi@Clinic#Admin2026!"

# Optional: Cloudinary credentials for high-performance image uploads on Vercel
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
